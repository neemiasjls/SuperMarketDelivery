# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env com valores reais

PORT=5002
JWT_SECRET=gere_uma_string_aleatoria_longa_aqui
NODE_ENV=development
FRONTEND_URL=http://localhost:5175
BODY_LIMIT=1mb

# Variaveis do container Postgres (usadas pelo docker-compose)
POSTGRES_DB=braga_db
POSTGRES_USER=braga_user
POSTGRES_PASSWORD=defina_uma_senha

# Conexao do Prisma com o Postgres.
# Se a senha tiver caracteres especiais (@ : / etc.), escape-os:
# por exemplo "@" vira "%40".
DATABASE_URL="postgresql://braga_user:defina_uma_senha@localhost:5432/braga_db?schema=public"
